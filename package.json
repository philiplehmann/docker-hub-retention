{
  "name": "docker-hub-retention",
  "description": "Github action to delete old images from Docker Hub",
  "license": "MIT",
  "version": "0.0.6",
  "main": "dist/retention.js",
  "author": "Philip Lehmann",
  "scripts": {
    "watch": "tsc --watch",
    "build": "tsc --noEmit",
    "lint": "biome check --write src/",
    "package:retention": "bun build src/retention.ts --bundle --minify --target=node --outfile=dist/retention.js",
    "package": "bun run package:retention",
    "test": "bun test --coverage",
    "release:build": "bun run lint && bun run build && bun run package",
    "github:release": "gh release create \"$(npm version ${VERSION_TYPE:-patch} --git-tag-version=false)\" -t Release -d=false -n \"\" -p=false",
    "git:commit": "git add -A && git commit -m \"Release\"",
    "git:push": "git push origin main && git push --tags",
    "release": "bun run release:build && bun run github:release && bun run git:commit && bun run git:push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philiplehmann/docker-hub-retention.git"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.3",
    "date-fns": "4.4.0",
    "typescript": "7.0.2",
    "yaml": "^2.4.5"
  },
  "packageManager": "bun@1.4.2"
}
